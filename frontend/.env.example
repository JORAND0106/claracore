# Copia a .env o .env.local (no commitear claves reales).
VITE_API_URL=http://127.0.0.1:8000
VITE_MAPBOX_TOKEN=
VITE_MAPTILER_KEY=tu_api_key_aqui
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Panel diagnóstico desarrollador (solo build; invisible para usuarios normales)
# Usar comillas si la clave contiene # (dotenv lo interpreta como comentario sin comillas)
VITE_DEVELOPER_PANEL_KEY=
# Misma connection string que APPLICATIONINSIGHTS_CONNECTION_STRING del backend (incluye ApplicationId)
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=
# Azure Portal → Application Insights → API Access → Create API Key (Read telemetry)
VITE_APPINSIGHTS_API_KEY=

# Producción (Azure Static Web App → Configuration): DEVELOPER_PANEL_KEY,
# APPLICATIONINSIGHTS_CONNECTION_STRING y APPINSIGHTS_API_KEY (proxy /api/appinsights/query).
