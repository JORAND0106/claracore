# Copiar a `.env` en desarrollo local. En Azure App Service: Configuration → Application settings.

# Supabase (obligatorio)
# SUPABASE_URL=
# SUPABASE_KEY=
# SECRET_KEY=
# ALGORITHM=HS256

# Azure Blob Storage — imágenes de la plataforma (SICOE, perfil, firmas, novedades, guías)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=claracore

AZURE_STORAGE_CONTAINER_PRIVADO=
CLARACORE_EMPRESA_RAZON_SOCIAL=
CLARACORE_EMPRESA_NIT=
CLARACORE_EMPRESA_EMAIL=
CLARACORE_EMPRESA_CIUDAD=
CLARACORE_EMPRESA_DIRECCION=
CLARACORE_EMPRESA_TELEFONO=
CLARACORE_EMPRESA_ELABORO_NOMBRE=
CLARACORE_EMPRESA_ELABORO_CARGO=
# IVA licenciamiento (fracción 0.19 = 19%). Prevalece contratos.iva del contrato de obra si existe.
# CLARACORE_LICENCIA_IVA_PORCENTAJE=0.19
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Auditor SST (IA) — https://docs.anthropic.com/en/docs/about-claude/models/overview
# ANTHROPIC_API_KEY=
# Por defecto claude-sonnet-4-6. Más económico: ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Auditor SST: salida JSON (max tokens), páginas rasterizadas, DPI — ver modulos_experimentales_routes.py
# AUDITOR_MAX_OUTPUT_TOKENS=8192
# AUDITOR_MAX_PAGES_TOTAL=28
# AUDITOR_PAGES_PER_PDF=8
# AUDITOR_DPI=110
# AUDITOR_MAX_IMAGES_MSG=24
# Tope acumulado (USD) antes de bloquear nuevas auditorías; 0 desactiva el control.
# El gasto se persiste en backend/.auditor_spend_state.json (o AUDITOR_SPEND_STATE_PATH).
# AUDITOR_SPEND_CAP_USD=5
# Clave que solo el cargo Desarrollador envía en POST /sst/auditor-desbloquear para reiniciar el acumulado.
# AUDITOR_DEV_CLAVE=
# Opcional: ruta absoluta del archivo de estado (por defecto: carpeta del backend).
# AUDITOR_SPEND_STATE_PATH=

# AVI — Asistente Virtual Inteligente
# Máximo de mensajes por usuario por día. Usa la misma ANTHROPIC_API_KEY de arriba.
# AVI_DAILY_LIMIT=50

# SMTP Zoho Mail — envío órdenes de pago (facturacion@claracore.co)
# Crear contraseña de aplicación en Zoho Mail → Seguridad → Contraseñas de aplicaciones.
# Local: agregar en backend/.env | Producción: Azure App Service → Configuration → Application settings
# CLARACORE_FACTURACION_SMTP_HOST=smtp.zoho.com
# CLARACORE_FACTURACION_SMTP_PORT=587
# CLARACORE_FACTURACION_SMTP_USER=facturacion@claracore.co
# CLARACORE_FACTURACION_SMTP_PASSWORD=
# CLARACORE_FACTURACION_FROM_EMAIL=facturacion@claracore.co
# CLARACORE_FACTURACION_FROM_NAME=Facturación ClaraCore
# CLARACORE_FACTURACION_SMTP_TLS=1

# SMTP Zoho Mail — correo de bienvenida al aprobar usuarios (contactenos@claracore.co)
# Misma infraestructura Zoho; cuenta y contraseña de aplicación distintas a facturación.
# HOST/PORT/TLS: si se omiten, se reutilizan CLARACORE_FACTURACION_SMTP_HOST/PORT/TLS.
# Ejecutar antes backend/sql/usuario_bienvenida_correo.sql en Supabase.
# CLARACORE_CONTACTO_SMTP_HOST=smtp.zoho.com
# CLARACORE_CONTACTO_SMTP_PORT=587
# CLARACORE_CONTACTO_SMTP_USER=contactenos@claracore.co
# CLARACORE_CONTACTO_SMTP_PASSWORD=
# CLARACORE_CONTACTO_FROM_EMAIL=contactenos@claracore.co
# CLARACORE_CONTACTO_FROM_NAME=ClaraCore
# CLARACORE_CONTACTO_SMTP_TLS=1
# URL del enlace «Ir a ClaraCore» en el correo de bienvenida
# CLARACORE_APP_URL=https://app.claracore.co

# Versión del texto legal de políticas (confidencialidad, Habeas Data, uso de la plataforma).
# Se guarda en `usuarios.politicas_version` cuando el usuario acepta en POST /usuarios/me/politicas-aceptar.
# Súbela cuando cambie el contenido legal para distinguir en auditoría qué texto aceptó cada persona.
# Debe alinearse con el texto mostrado en el front (p. ej. constante POLITICAS_TEXTO_VERSION en App.jsx).
# POLITICAS_VERSION=1.0
